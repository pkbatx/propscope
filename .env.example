# Copy to .env and edit. `docker compose` reads .env automatically.
#
#   cp .env.example .env
#   docker compose up -d
#   docker compose run --rm tui

# --- required -------------------------------------------------------------
# Any non-empty string. This postgres is bound to loopback and holds nothing
# secret, but an empty password is still a bad habit.
PGPASSWORD=change-me

# --- your station ---------------------------------------------------------
# Decimal degrees, west longitude negative. Used for the distance ranking of
# ionosondes and for the point where D-region absorption is sampled.
# Default is Austin, TX.
QTH_LAT=30.2672
QTH_LON=-97.7431

# Wall-clock timezone displayed next to Zulu. IANA name.
PROPSCOPE_TZ=America/Chicago

# --- optional -------------------------------------------------------------
# Postgres identifiers and the loopback port it publishes on.
# PGDATABASE=propscope
# PGUSER=propscope
# PGPORT=5432

# ntfy push notifications for Kp>=5 geomagnetic storms and for a source that
# has failed five times running. Leave NTFY_ALERT_TOPIC unset and nothing is
# ever sent -- there is no other notification path.
# NTFY_URL=https://ntfy.sh
# NTFY_ALERT_TOPIC=my-propagation-alerts
# NTFY_TOKEN=

# LOG_LEVEL=INFO
